{
  "source": "Shattered Pixel Dungeon 4.0.2",
  "definitions": {
    "aggression": {
      "name": "众矢之的",
      "description": "支配魔法正使附近所有敌人优先攻击该单位。\n\n剩余回合数：%s",
      "icon": "TARGETED",
      "tint": [
        1,
        1,
        1
      ],
      "kind": -1,
      "duration": 20,
      "counter": true,
      "fade": true,
      "source_class": "items/stones/StoneOfAggression.java#Aggression"
    },
    "block_shield": {
      "name": "招架",
      "description": "你的武器的招架附魔短时间内增强了你的防御能力！\n\n护盾剩余：%d\n\n剩余时间：%s",
      "icon": "ARMOR",
      "tint": [
        0.5,
        1,
        2
      ],
      "kind": 1,
      "duration": 0,
      "counter": true,
      "fade": true,
      "source_class": "items/weapon/enchantments/Blocking.java#BlockBuff"
    },
    "conserved_damage": {
      "name": "伤害储存",
      "description": "你的武器储存了上个杀敌一击的过剩能量，用来加强你的下次攻击以造成额外伤害。这份能量会慢慢随时间减弱。\n\n储存伤害：%d",
      "icon": "WEAPON",
      "tint": [
        1,
        0,
        0
      ],
      "kind": 1,
      "duration": 0,
      "counter": true,
      "fade": false,
      "source_class": "items/weapon/enchantments/Kinetic.java#ConservedDamage"
    },
    "deferred_damage": {
      "name": "延缓伤害",
      "description": "瞬时的伤害被延缓，随着时间慢慢释放。\n\n剩余的延迟伤害：%d",
      "icon": "DEFERRED",
      "tint": [
        1,
        1,
        1
      ],
      "kind": -1,
      "duration": 0,
      "counter": true,
      "fade": false,
      "source_class": "items/armor/glyphs/Viscosity.java#DeferedDamage"
    },
    "cleanse": {
      "name": "全面净化",
      "description": "这个角色暂时免疫所有的负面状态效果！\n\n剩余时长：%s",
      "icon": "IMMUNITY",
      "tint": [
        1,
        0,
        2
      ],
      "kind": 1,
      "duration": 5,
      "counter": true,
      "fade": true,
      "source_class": "items/potions/exotic/PotionOfCleansing.java#Cleanse"
    },
    "lightning_charge": {
      "name": "起电",
      "description": "战斗法师现已被充能，获得了对其雷霆魔杖的伤害免疫并扩大了其电弧的连锁范围。\n\n剩余回合数：%s",
      "icon": "IMBUE",
      "tint": [
        1,
        1,
        0
      ],
      "kind": 1,
      "duration": 10,
      "counter": true,
      "fade": false,
      "source_class": "items/wands/WandOfLightning.java#LightningCharge"
    },
    "magic_charge": {
      "name": "魔力强化",
      "description": "你的魔弹法杖向其他法杖回馈了一股能量，提升着下一次施法的有效等级。\n\n其他法杖被强化至：+%d\n\n剩余的魔力强化时长：%s回合",
      "icon": "UPGRADE",
      "tint": [
        0.2,
        0.6,
        1
      ],
      "kind": 1,
      "duration": 4,
      "counter": true,
      "fade": true,
      "source_class": "items/wands/WandOfMagicMissile.java#MagicCharge"
    },
    "rock_armor": {
      "name": "灵壤护甲",
      "description": "魔法泥石环绕在你身边，当你被攻击时泥石会尽其所能进行格挡，从而为你抵消50%%所受伤害。不过，抵消伤害会消除一定量的泥石。\n\n剩余护甲量：%1$d\n\n当积攒的泥石达到一定程度时，下一次发动灵壤法杖会使泥石成型为一尊灵壤守卫为你而战。\n\n守卫成型所需护甲量：%2$d",
      "icon": "ARMOR",
      "tint": [
        1.8,
        1.8,
        0.6
      ],
      "kind": 1,
      "duration": 0,
      "counter": true,
      "fade": true,
      "source_class": "items/wands/WandOfLivingEarth.java#RockArmor"
    },
    "earthroot_armor": {
      "name": "植被护甲",
      "description": "这是一种由层层树皮和藤蔓盘结而成的，不可移动的天然护甲。\n\n每当你受到物理攻击时，植被护甲都会吸收%d点伤害，直到其耐久被耗尽并瓦解。\n\n该护甲是不可移动的，所以一旦你离开原位护甲便会被破坏，消失不见。\n\n剩余护甲量：%d点",
      "icon": "ARMOR",
      "tint": [
        1,
        1,
        1
      ],
      "kind": 1,
      "duration": 0,
      "counter": true,
      "fade": true,
      "source_class": "plants/Earthroot.java#Armor"
    },
    "sungrass_heal": {
      "name": "草药疗养",
      "description": "阳春草拥有优秀的治疗能力，尽管治疗速率比治疗药剂慢很多。\n\n脱离植株将会打断治疗效果。\n\n剩余治疗量：%d",
      "icon": "HERB_HEALING",
      "tint": [
        1,
        1,
        1
      ],
      "kind": 1,
      "duration": 0,
      "counter": true,
      "fade": true,
      "source_class": "plants/Sungrass.java#Health"
    },
    "time_bubble": {
      "name": "时间气泡",
      "description": "这是一个加速时间运行的气泡。\n\n你可以在气泡中瞬间进行多次行动，但是攻击或施法都会打断这个效果。\n\n剩余时长：%s回合",
      "icon": "TIME",
      "tint": [
        1,
        1,
        0
      ],
      "kind": 1,
      "duration": 0,
      "counter": true,
      "fade": true,
      "source_class": "plants/Swiftthistle.java#TimeBubble"
    },
    "shuriken_cooldown": {
      "name": "手里剑冷却",
      "description": "你近期不消耗回合地投掷了一个手里剑，必须等待冷却结束才能再次瞬间投掷手里剑。在此期间，手里剑仅能以武器攻速投掷。\n\n剩余回合数：%s",
      "icon": "THROWN_WEP",
      "tint": [
        0.6,
        0.6,
        0.6
      ],
      "kind": 0,
      "duration": 20,
      "counter": true,
      "fade": true,
      "source_class": "items/weapon/missiles/Shuriken.java#ShurikenInstantTracker"
    },
    "adrenaline": {
      "name": "激素涌动",
      "description": "由肾上腺素带来的纯粹的潜能爆发，激素涌动能够增强一名角色的移动和攻击速度。\n\n激素涌动允许角色拥有2倍的移动速度和1.5倍的攻击速度。\n\n激素涌动持续时间：%s回合",
      "icon": "UPGRADE",
      "tint": [
        1,
        0,
        0
      ],
      "kind": 1,
      "duration": 10,
      "counter": true,
      "fade": true,
      "source_class": "actors/buffs/Adrenaline.java#Adrenaline"
    },
    "amok": {
      "name": "狂乱",
      "description": "狂乱会导致目标陷入极度愤怒和混乱的状态。\n\n狂乱的生物会不分敌我地攻击任何靠近它们的人。\n\n狂乱效果的剩余时长：%s回合",
      "icon": "AMOK",
      "tint": [
        1,
        1,
        1
      ],
      "kind": -1,
      "duration": 0,
      "counter": true,
      "fade": false,
      "source_class": "actors/buffs/Amok.java#Amok"
    },
    "bleeding": {
      "name": "流血",
      "description": "伤口正在令人不安地涌出大量血液。\n\n流血每回合都会造成伤害。每回合这个伤害数值都会随机减少，直到出血最终停止。\n\n当前流血伤害：%d",
      "icon": "BLEEDING",
      "tint": [
        1,
        1,
        1
      ],
      "kind": -1,
      "duration": 0,
      "counter": true,
      "fade": false,
      "source_class": "actors/buffs/Bleeding.java#Bleeding"
    },
    "bless": {
      "name": "赐福",
      "description": "你的集中力正在喷薄而出，有人说这是神赐的礼物。\n\n赐福状态能够提高自己25%%的精准与闪避属性，使被赐福者在战斗中势如破竹。\n\n赐福效果剩余时长：%s回合",
      "icon": "BLESS",
      "tint": [
        1,
        1,
        1
      ],
      "kind": 1,
      "duration": 30,
      "counter": true,
      "fade": true,
      "source_class": "actors/buffs/Bless.java#Bless"
    },
    "blindness": {
      "name": "失明",
      "description": "失明使周遭的一切陷入黑暗。\n\n失明时，单位的视距被减少至一格，致使远程攻击难堪大用，并使其很容易失去对远处敌人的追踪。此外，失明的英雄无法阅读卷轴或书籍。\n\n失明效果剩余时长：%s回合",
      "icon": "BLINDNESS",
      "tint": [
        1,
        1,
        1
      ],
      "kind": -1,
      "duration": 10,
      "counter": true,
      "fade": true,
      "source_class": "actors/buffs/Blindness.java#Blindness"
    },
    "blob_immunity": {
      "name": "净化屏障",
      "description": "一种奇怪的能量环绕在你的周围，为你阻挡有害的环境效果。\n\n在净化屏障的持续时间内，你将免疫所有负面环境效果。\n\n免疫效果剩余时长：%s回合",
      "icon": "IMMUNITY",
      "tint": [
        1,
        1,
        1
      ],
      "kind": 1,
      "duration": 20,
      "counter": true,
      "fade": true,
      "source_class": "actors/buffs/BlobImmunity.java#BlobImmunity"
    },
    "burning": {
      "name": "燃烧",
      "description": "没什么比被火焰吞没更痛苦了。\n\n火焰每回合都会造成伤害，直到它被液体扑灭或者自行消散。火会在你进入水中时熄灭，打碎药瓶产生的水花也具有同样的效果。\n\n此外，火焰还会点燃所有接触到的可燃地形与可燃物。\n\n燃烧效果剩余时长：%s回合",
      "icon": "FIRE",
      "tint": [
        1,
        1,
        1
      ],
      "kind": -1,
      "duration": 8,
      "counter": true,
      "fade": true,
      "source_class": "actors/buffs/Burning.java#Burning"
    },
    "charm": {
      "name": "魅惑",
      "description": "魅惑是一种能让一对夙敌暂时陷入互相倾慕的控制类魔法。\n\n被魅惑的单位将无法对魅惑施行者进行直接攻击，但依然可以攻击其他敌人。伤痛会激醒被魅惑单位，减少魅惑状态的持续时间。\n\n魅惑效果剩余时间：%s回合",
      "icon": "HEART",
      "tint": [
        1,
        1,
        1
      ],
      "kind": -1,
      "duration": 10,
      "counter": true,
      "fade": true,
      "source_class": "actors/buffs/Charm.java#Charm"
    },
    "chill": {
      "name": "冻伤",
      "description": "还没有完全冻住，不过已经非常冷了。\n\n冻伤的目标所有行动都会更加缓慢，减速程度取决于剩余的冻伤效果时间。最严重的冻伤情况等同于迟缓效果。\n\n冻伤效果剩余时长：%1$s回合\n当前减少的速度：%2$s%%",
      "icon": "FROST",
      "tint": [
        1,
        1,
        1
      ],
      "kind": -1,
      "duration": 10,
      "counter": true,
      "fade": true,
      "source_class": "actors/buffs/Chill.java#Chill"
    },
    "corrosion": {
      "name": "酸蚀",
      "description": "强酸能以惊人的速度腐蚀掉血肉、金属和骨头。\n\n目标被腐蚀的时间越长，酸蚀伤害越高。\n\n酸蚀效果剩余时长：%1$s回合\n当前酸蚀伤害：%2$d",
      "icon": "POISON",
      "tint": [
        1,
        0.5,
        0
      ],
      "kind": -1,
      "duration": 0,
      "counter": true,
      "fade": false,
      "source_class": "actors/buffs/Corrosion.java#Corrosion"
    },
    "corruption": {
      "name": "腐化",
      "description": "腐化魔法会侵入生物体的生命本质，扭转他们原有的天性。\n\n被腐化的生物会攻击他们的盟友，还会忽视其原先的敌人。腐化效果同时也是有伤害性的，会导致其目标缓慢走向死亡。\n\n腐化是永久性的，死后才能解脱。",
      "icon": "CORRUPT",
      "tint": [
        1,
        1,
        1
      ],
      "kind": -1,
      "duration": 0,
      "counter": false,
      "fade": false,
      "source_class": "actors/buffs/Corruption.java#Corruption"
    },
    "cripple": {
      "name": "残废",
      "description": "你很确定自己的腿不该折成那样。\n\n残废会减半移动速度，移动一格会消耗二回合而不是正常情况下的一回合。\n\n残废效果剩余时长：%s回合",
      "icon": "CRIPPLE",
      "tint": [
        1,
        1,
        1
      ],
      "kind": -1,
      "duration": 10,
      "counter": true,
      "fade": true,
      "source_class": "actors/buffs/Cripple.java#Cripple"
    },
    "daze": {
      "name": "恍惚",
      "description": "耳畔嗡鸣，视野模糊，战斗因此变得十分困难。\n\n在恍惚状态下，精准和闪避都会减少50%%，使得命中和躲避都变得更加困难。\n\n剩余回合数：%s",
      "icon": "DAZE",
      "tint": [
        1,
        1,
        1
      ],
      "kind": -1,
      "duration": 5,
      "counter": true,
      "fade": true,
      "source_class": "actors/buffs/Daze.java#Daze"
    },
    "degrade": {
      "name": "降级",
      "description": "强大的黑暗魔法正在吞噬升级卷轴注入你装备的魔力！\n\n降级状态下的装备会被视作比起原有等级更低的状态。_超过3级的每次升级都会遭受愈加严重的反噬。_物品的描述也会根据降级的影响而改变。\n\n不过，降级不会影响法杖充能、投掷武器耐久以及神器。\n\n降级效果剩余时长：%s回合\n\n使用一张升级卷轴或祛邪卷轴可以立即驱散这种黑暗魔法。",
      "icon": "DEGRADE",
      "tint": [
        1,
        1,
        1
      ],
      "kind": -1,
      "duration": 30,
      "counter": true,
      "fade": true,
      "source_class": "actors/buffs/Degrade.java#Degrade"
    },
    "doom": {
      "name": "定命",
      "description": "当整个宇宙都看起来想置你于死地时，继续斗争还有什么意义呢？\n\n被定命的角色受到的任何伤害都会提升67%。\n\n定命是永久性的，死后才能解脱。",
      "icon": "CORRUPT",
      "tint": [
        1,
        1,
        1
      ],
      "kind": -1,
      "duration": 0,
      "counter": false,
      "fade": false,
      "source_class": "actors/buffs/Doom.java#Doom"
    },
    "dread": {
      "name": "魂飞魄散",
      "description": "令人魂飞魄散的恐慌正在驱使目标尝试逃出这座地牢！\n\n魂飞魄散状态下的生物将快速逃离它们的敌人，并且会在脱离敌人视野后立即消失在整座地牢中。逃离的敌人不会掉落道具，只会给予玩家减半的经验值奖励。伤害所造成的痛楚将促使其镇定下来。\n\n魂飞魄散效果剩余时长：%d回合",
      "icon": "TERROR",
      "tint": [
        1,
        0,
        0
      ],
      "kind": -1,
      "duration": 20,
      "counter": true,
      "fade": true,
      "source_class": "actors/buffs/Dread.java#Dread"
    },
    "drowsy": {
      "name": "催眠",
      "description": "一股魔法力量使目标很难保持清醒，几个回合后，目标将会深陷魔法睡眠。\n\n对于英雄，若在本应睡着的那一回合为满生命值或在这个过程中受到了伤害，魔法睡眠则不会生效。\n\n入睡所需回合数：%s回合",
      "icon": "DROWSY",
      "tint": [
        1,
        1,
        1
      ],
      "kind": 0,
      "duration": 5,
      "counter": true,
      "fade": true,
      "source_class": "actors/buffs/Drowsy.java#Drowsy"
    },
    "enhanced_rings": {
      "name": "戒指强化",
      "description": "盗贼在使用神器时强化了他的戒指，使它们获得+1升级。\n\n剩余回合数：%s",
      "icon": "UPGRADE",
      "tint": [
        0,
        1,
        0
      ],
      "kind": 1,
      "duration": 0,
      "counter": true,
      "fade": true,
      "source_class": "actors/buffs/EnhancedRings.java#EnhancedRings"
    },
    "frost": {
      "name": "冻结",
      "description": "不要与冻成冰雕混淆，这种温和的冰冻只是把目标包裹在冰里。\n\n冻结效果类似于麻痹，使目标不能行动。与麻痹不同的是，冻结效果会在目标受到伤害时立即消失，因为冰会碎。\n\n剩余的冻结效果时长：%s回合",
      "icon": "FROST",
      "tint": [
        0,
        0.75,
        1
      ],
      "kind": -1,
      "duration": 10,
      "counter": true,
      "fade": true,
      "source_class": "actors/buffs/Frost.java#Frost"
    },
    "haste": {
      "name": "极速",
      "description": "强大的能量灌入到你的双腿肌肉上，允许你以不可思议的速度移动！\n\n在极速状态下，你将拥有3倍的移动速度，但是其他行动速度仍然和原来一样。\n\n极速效果剩余时长：%s回合",
      "icon": "HASTE",
      "tint": [
        1,
        0.8,
        0
      ],
      "kind": 1,
      "duration": 10,
      "counter": true,
      "fade": true,
      "source_class": "actors/buffs/Haste.java#Haste"
    },
    "healing": {
      "name": "治疗",
      "description": "每回合恢复2点生命，持续20回合。受到攻击命中或有效伤害时立即结束；再次饮用治疗药剂会刷新持续时间。\n\n剩余治疗时长：%s回合",
      "icon": "HEALING",
      "tint": [
        1,
        1,
        1
      ],
      "kind": 1,
      "duration": 20,
      "counter": true,
      "fade": true,
      "source_class": "actors/buffs/Healing.java#Healing",
      "legacy_description": "一股治愈魔力让你的伤口开始愈合。\n\n你的生命将逐回合稳定回复，直到治疗效果终止。治疗量将随着时间逐渐减少。\n\n下一回合治疗量：%d\n\n剩余治疗量：%d。"
    },
    "hex": {
      "name": "幻惑",
      "description": "干扰集中力的黑暗魔法，使目标无法准确地判断方位。\n\n幻惑状态会降低目标20%%的精准与闪避属性，使其在战斗中更容易处于下风。\n\n幻惑效果剩余时长：%s回合",
      "icon": "HEX",
