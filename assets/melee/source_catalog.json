  "messages": {
    "ceremonialcandle": {
      "name": "仪式蜡烛",
      "desc": "一套配套的蜡烛，在使用中融化在了一起。\r\n\r\n单独看来它们毫无价值，但与其它蜡烛按特定排布共用时却能为召唤仪式聚集能量。"
    },
    "corpsedust": {
      "name": "尸尘",
      "desc": "在外观上这团尸尘和普通灰尘差不多。而你却能够感受到其中潜伏着一股充满恶意的魔力。\r\n\r\n尽快脱手为好。"
    },
    "darkgold": {
      "name": "暗金矿",
      "desc": "这种金属名中的暗并非源于其色泽(它看起来和普通黄金一样)，而是因为它会在阳光下熔化，令其在地表上毫无用处。"
    },
    "dwarftoken": {
      "name": "矮人徽记",
      "desc": "一块形状奇特的金属片，被宝库中的矮人守卫随身携带。或许这徽记也是将守卫禁锢于这座宝库的魔法的一部分？最好先带着它，或许还会有用。"
    },
    "embers": {
      "name": "元素余烬",
      "desc": "只能从新生火焰元素身上采集到的特殊余烬.。它们散发着温暖的能量。"
    },
    "escapecrystal": {
      "name": "逃脱棱晶",
      "desc": "一块似乎内含着传送魔法的细长棱晶。你随时都可以使用这块棱晶离开宝库，但若是提早离开的话可别想拿到最好的报酬！"
    },
    "gooblob": {
      "name": "粘咕球",
      "desc": "一团晃动着的黏糊糊球体，是从粘咕尸体上崩解下的一部分。看起来像是一个大果冻球，不过大概不能食用。\r\n\r\n该物品自身并没有什么实际用途，不过它在与特定药剂或炸弹共炼后可能有妙用。再不济，它也能提供相当的炼金能量。"
    },
    "impstatue": {
      "name": "黑曜石雕像",
      "desc": "一块小小的漆黑雕塑，由黑曜石雕成。它的外表与委托你进入宝库的那位小恶魔神似，连那闪亮的绿眼睛也颇为相像。雕像的底座上用你没有见过的语言刻着一串铭文。"
    },
    "vaultbeacon": {
      "name": "宝库信标",
      "desc": "这个信标内含的魔法似乎能带你回到一个特定的位置，目的地很可能就是你找到它的那个房间。\r\n\r\n你可以用它节省一点探索的时间，若是身处险境也可以用它逃出生天。"
    },
    "metalshard": {
      "name": "邪能碎片",
      "desc": "一块被诅咒的金属锈片，它是DM-300的装甲外壳被击碎时分离出来的。你能感受到某种尚未激活的恶毒魔力潜藏其中。\r\n\r\n该物品自身并没有什么实际用途，不过它在与特定卷轴或炸弹共炼时可能有妙用。再不济，它也能提供相当的炼金能量。"
    },
    "pickaxe": {
      "name": "镐子",
      "desc": "这是一件笨重但十分耐用的凿岩工具。不需要装备上就能作为挖掘工具使用，但在紧要关头也能作为武器装备。"
    },
    "assassinsblade": {
      "name": "暗杀之刃",
      "desc": "黑曜石制的波浪形短刃，虽轻便但不易用，如果能击中要害足以致命。"
    },
    "battleaxe": {
      "name": "战斧",
      "desc": "这把有着硕大钢制头部的战斧能将庞大的力量倾注在每次挥舞之中。"
    },
    "crossbow": {
      "name": "十字弩",
      "desc": "这是一件看起来相当精密复杂的装置，能够将飞镖一样的小型箭矢以极高的速度射出。这把十字弩掂在手里沉甸甸的，比想象中结实很多，虽然完全违背了设计初衷，不过也能够在肉搏战中起到作用。"
    },
    "cudgel": {
      "name": "权杖",
      "desc": "一把小型黄铜锤，更多的作为贵族们的自卫工具而非冒险用武器使用。"
    },
    "dagger": {
      "name": "匕首",
      "desc": "木柄被磨损的简易铁质匕首。"
    },
    "dirk": {
      "name": "长匕首",
      "desc": "一个长一些的刺击型匕首，可以往敌人身体里捅得更深一点。"
    },
    "flail": {
      "name": "链枷",
      "desc": "铁链上附着的一个带刺的钢球。笨重难用，能命中的话威力极强。"
    },
    "gauntlet": {
      "name": "魔岩拳套",
      "desc": "这个巨大的拳套由一匹红布和层层覆盖在布上的魔法岩石交织而成。戴上后，布料紧紧裹住你的整个前臂，让厚重的岩板变得像一层坚硬的皮肤。要有足够的力量才能将如此沉重的武器自如挥舞，但正是这种力量和重量的结合让这件武器发挥出可怕的威力。"
    },
    "glaive": {
      "name": "关刀",
      "desc": "一支在末端装有剑刃的重型长柄武器。"
    },
    "gloves": {
      "name": "镶钉手套",
      "desc": "这双镶钉手套没有多少防护作用，但能在勉强当作武器使用的同时腾出双手。"
    },
    "greataxe": {
      "name": "巨斧",
      "desc": "这个巨型的战斧无坚不摧，重如泰山，举过肩才有空间挥舞。"
    },
    "greatshield": {
      "name": "巨型方盾",
      "desc": "与其说它是一面盾，不如说它是一堵能移动的墙。这一大块金属对于防御十分有效，但没有在攻击方面留下多少余地。"
    },
    "greatsword": {
      "name": "巨剑",
      "desc": "这把大剑进行的每次沉重挥舞都能造成大量伤害。"
    },
    "handaxe": {
      "name": "手斧",
      "desc": "一把轻斧头，通常用来砍树。当然，它的宽刃对敌人来说同样有效。"
    },
    "katana": {
      "name": "武士刀",
      "desc": "一把在握柄上方带有巨大金属护手的修长刀刃。"
    },
    "longsword": {
      "name": "长剑",
      "desc": "这柄剑的厚长利刃闪烁着令人宽心的寒光，不过这长度也确实让它非常沉重。"
    },
    "mace": {
      "name": "硬头锤",
      "desc": "这把武器前端的大型铁头能够造成可观的伤害。"
    },
    "magesstaff": {
      "name": "法师魔杖",
      "desc": "这根魔杖是件独一无二的魔法武器，由法师亲自雕琢而成，能注入其它法杖的魔力以获取新的力量。"
    },
    "meleeweapon": {},
    "shortsword": {
      "name": "短剑",
      "desc": "它确实相当短，只比一把匕首长出几厘米。"
    },
    "quarterstaff": {
      "name": "铁头棍",
      "desc": "这是两端以铁包覆的硬木棍。"
    },
    "rapier": {
      "name": "刺剑",
      "desc": "一柄修长而笔直的利器，牺牲了部分劈砍能力而获得一定的保护效果。"
    },
    "roundshield": {
      "name": "圆盾",
      "desc": "这个大盾可以有效格挡攻击，在危机时刻也可以作为不错的武器使用。"
    },
    "runicblade": {
      "name": "符文之刃",
      "desc": "来自失落之地的神秘武器，有着明亮的蓝色刀刃。"
    },
    "sai": {
      "name": "双钗",
      "desc": "一对轻薄的铁刃，刚好一手一把。在快速斩击方面十分出色。"
    },
    "scimitar": {
      "name": "弯刀",
      "desc": "一把厚重的弯刀。它的形状能让它进行更快但不甚强力的攻击。"
    },
    "sickle": {
      "name": "短柄镰",
      "desc": "一种手持农具，也可被用作一把强大但笨重的武器。"
    },
    "spear": {
      "name": "长矛",
      "desc": "这是一根装着锋锐铁刺的细长木杆。"
    },
    "sword": {
      "name": "单手剑",
      "desc": "平衡性良好的剑。不算太大，但是依然比短剑长上不少。"
    },
    "warhammer": {
      "name": "战锤",
      "desc": "很少有生物能抵挡这铅铁巨块的辗压，但也只有最强壮的冒险家才能有效使用它。"
    },
    "warscythe": {
      "name": "战镰",
      "desc": "这件巨大又笨重的农具被加固了。现在比起收割庄稼，它更适宜于收割敌人。"
    },
    "whip": {
      "name": "长鞭",
      "desc": "虽然这把武器另一端带倒刺的绳子伤害不高，但它的攻击范围是数一数二的。"
    },
    "wornshortsword": {
      "name": "破旧的短剑",
      "desc": "一把十分短的剑，在大量使用后有一定的磨损。它比正常情况的短剑更轻，也更弱。"
    }
  },
  "wand_messages": {
    "wandofblastwave": {
      "staff_name": "冲击波魔杖",
      "bmage_desc": "当_战斗法师_以冲击波魔杖近战攻击已经被麻痹的目标时，将消耗目标身上剩余的麻痹回合数造成大量魔法伤害。此效果对每个目标均有短暂的冷却。"
    },
    "wandofcorrosion": {
      "staff_name": "酸蚀魔杖",
      "bmage_desc": "当_战斗法师_以酸蚀魔杖近战攻击目标时，有概率使其沾染腐蚀淤泥。"
    },
    "wandofcorruption": {
      "staff_name": "腐化魔杖",
      "bmage_desc": "当_战斗法师_以腐化魔杖近战攻击目标时，有概率使其陷入狂乱。"
    },
    "wandofdisintegration": {
      "staff_name": "解离魔杖",
      "bmage_desc": "当_战斗法师_以解离魔杖作为近战武器时，魔杖会像索敌附魔一样获得额外的攻击距离。"
    },
    "wandoffireblast": {
      "staff_name": "焰浪魔杖",
      "bmage_desc": "当_战斗法师_以焰浪魔杖近战攻击目标时，有概率吸收所有邻近的火焰并制造出一场爆炸！与敌人相邻的火焰越多，触发该效果的概率越高。"
    },
    "wandoffrost": {
      "staff_name": "冰霜魔杖",
      "bmage_desc": "当_战斗法师_以冰霜魔杖近战攻击目标时，有概率将其直接冻结。目标冻伤越严重，被冻结的概率就越高。"
    },
    "wandoflightning": {
      "staff_name": "雷霆魔杖",
      "bmage_desc": "当_战斗法师_以雷霆魔杖近战攻击目标时，有概率获得10回合起电效果。起电状态下的战斗法师免疫雷电伤害，电弧的连锁范围也更广。"
    },
    "wandoflivingearth": {
      "staff_name": "灵壤魔杖",
      "bmage_desc": "当_战斗法师_以灵壤魔杖近战攻击目标时，能将部分近战伤害转化为灵壤护甲。"
    },
    "wandofmagicmissile": {
      "staff_name": "魔弹魔杖",
      "bmage_desc": "当_战斗法师_以魔弹魔杖近战攻击目标时，魔杖外的所有的法杖都会恢复一定的充能。"
    },
    "wandofprismaticlight": {
      "staff_name": "棱光魔杖",
      "bmage_desc": "当_战斗法师_以棱光魔杖近战攻击目标时，能使目标陷入随魔杖等级提升而延长的残废效果。"
    },
    "wandofregrowth": {
      "staff_name": "再生魔杖",
      "bmage_desc": "当_战斗法师_以再生魔杖近战攻击目标时，如果一方站在草地上，则战斗法师能获取伤害的一定比例的草药疗养。"
    },
    "wandoftransfusion": {
      "staff_name": "注魂魔杖",
      "bmage_desc": "当_战斗法师_以注魂魔杖近战攻击被魅惑的目标时，能获取一定的护盾且下次释放不消耗生命。"
    },
    "wandofwarding": {
      "staff_name": "哨卫魔杖",
      "bmage_desc": "当_战斗法师_以哨卫魔杖近战攻击目标时，有概率为所有哨卫元素和哨卫结晶恢复一定生命值。"
    }
  },
